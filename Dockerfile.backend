# ============================================================
#  TaskFlow — Dockerfile Backend (Python / FastAPI)
#  Linguagem: Dockerfile
# ============================================================

# ── Stage 1: dependências ────────────────────────────────────
FROM python:3.12-slim AS builder

WORKDIR /app

# Instala dependências de build
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copia e instala requirements (cache layer)
COPY backend/requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# ── Stage 2: runtime ─────────────────────────────────────────
FROM python:3.12-slim AS runtime

WORKDIR /app

# Usuário não-root por segurança
RUN addgroup --system appgroup && adduser --system --ingroup appgroup appuser

# Copia dependências instaladas do builder
COPY --from=builder /root/.local /home/appuser/.local

# Copia código da aplicação
COPY backend/ ./backend/
COPY frontend/ ./frontend/

# Diretório para o banco SQLite
RUN mkdir -p /app/data && chown -R appuser:appgroup /app

USER appuser

ENV PATH="/home/appuser/.local/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV DATABASE_URL="sqlite:////app/data/taskflow.db"

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]

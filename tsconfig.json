{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "moduleResolution": "bundler",
    "skipLibCheck": true
  },
  "include": ["frontend/**/*.ts", "frontend/**/*.d.ts"]
}
